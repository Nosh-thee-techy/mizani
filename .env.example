# Gemma/Gemini API (OpenAI-compatible endpoint — key only, not a curl command)
GEMMA_API_KEY=your_api_key_here
GEMMA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMMA_MODEL=gemini-flash-latest

# Africa's Talking sandbox (username is always "sandbox" in the test env)
AT_USERNAME=sandbox
AT_API_KEY=your_sandbox_api_key_here

# SQLite database path (relative to project root)
DATABASE_PATH=mizani.db

# Directory where uploaded document photos are stored
UPLOAD_DIR=uploads

# --- React Native (Expo) client ---
# Set this in mobile/.env as EXPO_PUBLIC_API_URL
# Local emulator/simulator: http://10.0.2.2:8000 (Android) or http://localhost:8000 (iOS)
# Physical device / demo: your ngrok URL, e.g. https://xxxx.ngrok-free.dev
# (same host as the USSD callback, without the /ussd path)
